{
  "manifest_version": 3,
  "name": "NOTEIFY",
  "version": "1.0.0",
  "description": "NOTEIFY quietly tracks silent DOM changes (live feeds, chat, popups, scores) and announces an opt-in summary to screen readers like NVDA via Alt+S.",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_title": "NOTEIFY",
    "default_icon": "logo.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["mainfile.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}